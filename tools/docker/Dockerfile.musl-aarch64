FROM alpine:3.18

# Pinned to alpine:3.18 to match dd-trace-dotnet's aarch64 musl build environment
# (tracer/build/_build/docker/alpine.build.arm64.dockerfile). No prebuilt
# rust:alpine3.18 image exists since Alpine 3.18 reached EOL, so Rust is installed
# via rustup below. dd-trace-dotnet's NativeValidation enforces an alpine 3.14
# symbol floor (musl 1.2.2 + libgcc 10.3.1); 3.18 is the closest still-installable
# Alpine that matches its aarch64 build host.

# Install build tools required by the libdatadog builder crate.
# musl-dev provides musl sysroot headers/libs for native compilation.
# cmake and make are required by the aws-lc-sys build script.
# perl is required by the OpenSSL/AWS-LC build.
# ca-certificates is required for rustup to fetch over HTTPS.
# binutils provides objcopy (see the crt decompression step below).
RUN apk add --no-cache musl-dev gcc g++ make curl perl cmake ca-certificates binutils

# Alpine builds its libc crt objects (crti.o, crtn.o, ...) with zlib-compressed
# debug sections. libdatadog's otel-thread-ctx-ffi crate forces the link through
# rust's bundled rust-lld (cc -fuse-ld=lld -B.../gcc-ld, to merge version scripts
# and keep the TLSDESC dynsym entry), and rust-lld is built WITHOUT zlib support,
# so it can't read those sections and the link fails with:
#   rust-lld: error: /usr/lib/crtn.o:(.debug_line) is compressed with
#   ELFCOMPRESS_ZLIB, but lld is not built with zlib support
# Decompress them in place so rust-lld can read them. objcopy leaves already
# uncompressed objects untouched, so the loop is safe over every crt*.o.
RUN for f in $(find /usr/lib -name 'crt*.o'); do \
        objcopy --decompress-debug-sections "$f" "$f" || true; \
    done

# Match rust:alpine's layout so build.sh's PATH override (which prepends
# /usr/local/cargo/bin) keeps working unchanged.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

ARG RUST_VERSION=1.87.0
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- --default-toolchain ${RUST_VERSION} --profile minimal -y --no-modify-path \
 && rustc --version \
 && cargo --version
