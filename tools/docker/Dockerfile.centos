FROM ghcr.io/cross-rs/x86_64-unknown-linux-gnu:main-centos

# CentOS 7 is EOL
# Find and replace mirror.centos.org with vault.centos.org
# Remove the # sign at the beginning of lines containing baseurl=http to enable baseurl usage instead of disabling it
# Add a # sign to the beginning of lines containing mirrorlist=http to disable the use of mirrorlist
RUN sed -i s/mirror.centos.org/vault.centos.org/g /etc/yum.repos.d/*.repo \
    && sed -i s/^#.*baseurl=http/baseurl=http/g /etc/yum.repos.d/*.repo \
    && sed -i s/^mirrorlist=http/#mirrorlist=http/g /etc/yum.repos.d/*.repo

# centos-release-scl drops new CentOS-SCLo-*.repo files that still point at
# mirror.centos.org / mirrorlist.centos.org — both gone since CentOS 7 EOL.
# Re-run the same EOL repo fixup after installing it so the SCL repos resolve
# via vault.
RUN yum update -y \
    && yum install -y unzip centos-release-scl autoconf automake libtool m4 \
    && sed -i s/mirror.centos.org/vault.centos.org/g /etc/yum.repos.d/*.repo \
    && sed -i s/^#.*baseurl=http/baseurl=http/g /etc/yum.repos.d/*.repo \
    && sed -i s/^mirrorlist=http/#mirrorlist=http/g /etc/yum.repos.d/*.repo

# CentOS 7's stock gcc is 4.8.5, which doesn't ship <stdatomic.h>.  Starting
# with libdatadog v30, libdd-libunwind-sys vendors a copy of libunwind that
# requires C11 atomics, so we pull in devtoolset-10 (gcc 10) via SCL and put
# it first on PATH.  devtoolset still targets the system glibc (2.17), so the
# CentOS 7 ABI baseline is preserved.
# autoconf/automake/libtool/m4 (above) are required by libdd-libunwind-sys's
# `autoreconf -i` step.
RUN yum install -y devtoolset-10-gcc devtoolset-10-gcc-c++ devtoolset-10-binutils

# Force the devtoolset-10 toolchain end-to-end:
#   * PATH so unqualified `gcc`/`cc`/`g++` resolve to the new compiler.
#   * CC/CXX with explicit full paths so autotools `./configure` (used by
#     libdd-libunwind-sys) and cc-rs both pick GCC 10 deterministically,
#     even in subprocesses where PATH-based resolution might be missed.
#   * LD_LIBRARY_PATH so the GCC 10 binaries find their own libstdc++ etc.
#     at runtime — without this, gcc itself can fail to start when its
#     bundled libs differ from the system /usr/lib64 versions.
ENV PATH="/opt/rh/devtoolset-10/root/usr/bin:${PATH}" \
    CC=/opt/rh/devtoolset-10/root/usr/bin/gcc \
    CXX=/opt/rh/devtoolset-10/root/usr/bin/g++ \
    LD_LIBRARY_PATH=/opt/rh/devtoolset-10/root/usr/lib64:/opt/rh/devtoolset-10/root/usr/lib

# Build-time sanity check so an image build that silently shipped GCC 4.8.5
# fails loudly, not at the eventual libunwind compile.
RUN gcc --version && \
    echo '#include <stdatomic.h>' | gcc -E -x c - >/dev/null

# Use the devtoolset-10 gcc to link the output library against glibc 2.17.
# Rust is not installed in this image; the host Rust toolchain is mounted at
# /usr/local/cargo and /usr/local/rustup by the build script.
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=gcc
