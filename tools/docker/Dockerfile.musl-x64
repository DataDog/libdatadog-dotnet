FROM alpine:3.17

# Pinned to alpine:3.17 to match dd-trace-dotnet's musl build environment
# (tracer/build/_build/docker/alpine.build.dockerfile). No prebuilt rust:alpine3.17
# image exists since Alpine 3.17 reached EOL, so Rust is installed via rustup below.
# dd-trace-dotnet's NativeValidation enforces an alpine 3.14 symbol floor
# (musl 1.2.2 + libgcc 10.3.1); 3.17 is the closest still-installable Alpine.

# Install build tools required by the libdatadog builder crate.
# musl-dev provides musl sysroot headers/libs for native compilation.
# cmake and make are required by the aws-lc-sys build script.
# perl is required by the OpenSSL/AWS-LC build.
# ca-certificates is required for rustup to fetch over HTTPS.
# lld provides Alpine's system LLD, which (unlike rustup's bundled rust-lld) is
# built WITH zlib support -- see the ld.lld redirection step below.
RUN apk add --no-cache musl-dev gcc g++ make curl perl cmake ca-certificates lld

# Match rust:alpine's layout so build.sh's PATH override (which prepends
# /usr/local/cargo/bin) keeps working unchanged.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

ARG RUST_VERSION=1.87.0
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- --default-toolchain ${RUST_VERSION} --profile minimal -y --no-modify-path \
 && rustc --version \
 && cargo --version

# Route LLD-driven links through Alpine's system lld instead of rustup's rust-lld.
#
# libdatadog's otel-thread-ctx-ffi crate forces the final cdylib link through LLD
# (cc -fuse-ld=lld -B.../gcc-ld) to merge version scripts and keep the TLSDESC
# dynsym entry. rustup ships rust-lld, which is built WITHOUT zlib support, so it
# can't read the ELFCOMPRESS_ZLIB debug sections that Alpine's gcc/as emit by
# default for every C/asm object (libunwind, ring, the crt objects, ...) and the
# link fails with "compressed with ELFCOMPRESS_ZLIB, but lld is not built with
# zlib support". Trying to stop the compression per-dependency is whack-a-mole
# (every build system -- cc crate, autotools, cmake -- sets its own CFLAGS).
#
# Instead, point the toolchain's ld.lld shim at Alpine's system lld, which IS
# built with zlib and is new enough (LLVM 15) for the crate's TLSDESC / version
# script needs. This is exactly the "fall back to whatever lld the system
# provides" path the crate's build.rs is designed to take, and mirrors how
# upstream libdatadog builds on Alpine (system toolchain, not rustup's rust-lld).
RUN find "$RUSTUP_HOME" -path '*/gcc-ld/ld.lld' -exec ln -sf /usr/bin/ld.lld {} \;

# Our build script overrides CARGO_HOME to /root/.cargo for caching;
# cargo binary remains at /usr/local/cargo/bin via the image PATH.
