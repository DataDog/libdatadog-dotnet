FROM alpine:3.17

# Pinned to alpine:3.17 to match dd-trace-dotnet's musl build environment
# (tracer/build/_build/docker/alpine.build.dockerfile). No prebuilt rust:alpine3.17
# image exists since Alpine 3.17 reached EOL, so Rust is installed via rustup below.
# dd-trace-dotnet's NativeValidation enforces an alpine 3.14 symbol floor
# (musl 1.2.2 + libgcc 10.3.1); 3.17 is the closest still-installable Alpine.

# Install build tools required by the libdatadog builder crate.
# musl-dev provides musl sysroot headers/libs for native compilation.
# cmake and make are required by the aws-lc-sys build script.
# perl is required by the OpenSSL/AWS-LC build.
# ca-certificates is required for rustup to fetch over HTTPS.
# binutils provides objcopy (see the crt decompression step below).
RUN apk add --no-cache musl-dev gcc g++ make curl perl cmake ca-certificates binutils

# Alpine's gcc/as compress debug sections by default (ELFCOMPRESS_ZLIB).
# libdatadog's otel-thread-ctx-ffi crate forces the final link through rust's
# bundled rust-lld (cc -fuse-ld=lld -B.../gcc-ld, to merge version scripts and
# keep the TLSDESC dynsym entry), and rust-lld is built WITHOUT zlib support, so
# it can't read compressed debug sections and every such object breaks the link:
#   rust-lld: error: ...:(.debug_line) is compressed with ELFCOMPRESS_ZLIB,
#   but lld is not built with zlib support
# Two sources of compressed objects, fixed two ways:
#
# 1. Prebuilt libc/gcc crt objects (crti.o, crtn.o, ...) shipped compressed by
#    the Alpine packages. Decompress them in place (objcopy no-ops on already
#    uncompressed objects, so the loop is safe over every crt*.o).
RUN for f in $(find /usr/lib -name 'crt*.o'); do \
        objcopy --decompress-debug-sections "$f" "$f" || true; \
    done

# 2. Objects compiled during the build itself (ring, zstd-sys, libunwind, ...).
#    -gz=none disables debug-section compression for every C/C++/asm compile
#    (gcc forwards it as --nocompress-debug-sections to the assembler), so the
#    objects rust-lld ends up linking are readable.
ENV CFLAGS="-gz=none" \
    CXXFLAGS="-gz=none"

# Match rust:alpine's layout so build.sh's PATH override (which prepends
# /usr/local/cargo/bin) keeps working unchanged.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

ARG RUST_VERSION=1.87.0
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- --default-toolchain ${RUST_VERSION} --profile minimal -y --no-modify-path \
 && rustc --version \
 && cargo --version

# Our build script overrides CARGO_HOME to /root/.cargo for caching;
# cargo binary remains at /usr/local/cargo/bin via the image PATH.
