# Native arm64 builder for aarch64-unknown-linux-gnu, run under QEMU
# emulation via `--platform linux/arm64`.  Mirrors what upstream libdatadog
# does in docker-bake.hcl ("debian-build-aarch64") and what we already do
# for aarch64-alpine-linux-musl, because libdd-libunwind-sys (new in
# libdatadog v30) runs `./configure && make` from its build.rs without
# any cross-compile wiring — it must be built natively on the target arch.
#
# manylinux2014_aarch64 is the pypa-maintained image used by the Python
# packaging community for building aarch64 wheels with maximum
# compatibility.  It's CentOS 7 (glibc 2.17 baseline) with devtoolset-10
# (GCC 10) and the autotools chain already installed — exactly what we
# need.  Plain `centos:7 --platform linux/arm64` would NOT work because
# CentOS 7's SCL `rh` collection (devtoolset-*) was never published for
# aarch64.
FROM quay.io/pypa/manylinux2014_aarch64

# Install Rust.  This image is self-contained because the host runner is
# x86_64 — we can't mount its cargo/rustup binaries into an arm64 container.
# rustup's stable aarch64-unknown-linux-gnu build is linked against glibc
# 2.17, which matches the manylinux2014 base.
# CARGO_HOME / RUSTUP_HOME use /root paths so this image plugs into the
# same docker_run_musl helper in build.sh that orchestrates the other
# QEMU-emulated arm64 build (rust:alpine convention).
ENV CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --default-toolchain stable --profile minimal --no-modify-path \
    && rm /tmp/rustup-init.sh
ENV PATH="/root/.cargo/bin:${PATH}"

# Build-time sanity check.
RUN gcc --version \
    && echo '#include <stdatomic.h>' | gcc -E -x c - >/dev/null \
    && rustc --version && cargo --version

# Use the devtoolset-10 gcc (already first on PATH from the base image)
# to link the output library against glibc 2.17.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=gcc
